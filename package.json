{
  "version": "2.0.0",
  "name": "@tws-js/client",
  "description": "Type-Safe Web Server Client",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": "https://github.com/sergiodeveloper/tws-client",
  "bin": {
    "tws-types": "dist/twsTypesCommand.js"
  },
  "scripts": {
    "test": "npm run unit && npm run e2e",
    "unit": "NODE_OPTIONS=--enable-source-maps bun test test/unit",
    "e2e": "NODE_OPTIONS=--enable-source-maps bun test test/e2e --timeout=500 && npm run lint-nofix",
    "lint": "eslint src test --fix && npx tsc --noEmit && cd test && npx tsc && cd ..",
    "lint-nofix": "eslint src test && npx tsc --noEmit && cd test && npx tsc && cd ..",
    "build": "rm -rf dist && tsc",
    "deploy": "npm run lint-nofix && npm test && npm run build && npm publish --access=public"
  },
  "devDependencies": {
    "@tws-js/server": "^2.2.1",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-sonarjs": "^0.19.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@tws-js/common": "^1.0.0",
    "axios": "^1.3.6",
    "json5": "^2.2.3",
    "socket.io-client": "^4.8.1"
  }
}
